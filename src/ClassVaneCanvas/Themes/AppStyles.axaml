<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 分割线：用 Border 而不是 Separator，保证在 StackPanel 中始终是水平线且跟随主题 -->
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource CvDividerBrush}" />
  </Style>

  <!-- 触摸友好的大尺寸按钮 -->
  <Style Selector="Button.touch">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="176" />
    <Setter Property="Padding" Value="22,10" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.touch.accent">
    <Setter Property="Background" Value="{DynamicResource CvAccentBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.touch.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CvAccentHoverBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.touch.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CvAccentHoverBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.touch.danger">
    <Setter Property="Background" Value="{DynamicResource CvDangerBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.touch.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CvDangerHoverBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.touch.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CvDangerHoverBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- 文本链接：统一去内边距，下划线由内容 TextBlock 提供 -->
  <Style Selector="HyperlinkButton.link">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

</Styles>
